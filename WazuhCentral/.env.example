# -----------------------------------------------------------------------------
# Образы
# -----------------------------------------------------------------------------
# Файл сохраняйте с переводами строк LF (Unix). На сервере при проблемах с логином: dos2unix .env
# Символ $ в значениях для docker compose удваивайте: $$
WAZUH_IMAGE_VERSION=4.14.5

# Память JVM indexer (одна строка, без пробелов в начале)
OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g

# -----------------------------------------------------------------------------
# Подключение manager → indexer (как в официальном compose)
# -----------------------------------------------------------------------------
INDEXER_URL=https://wazuh.indexer:9200

# URL indexer внутри ossec.conf (блок <indexer><hosts>) — обычно тот же хост в Docker-сети
INDEXER_URL_INTERNAL=https://wazuh.indexer:9200

# Пользователь OpenSearch `admin` (имя не меняйте без правок internal_users.yml.template)
INDEXER_USERNAME=admin
INDEXER_PASSWORD=SecretPassword

# Пользователь OpenSearch `kibanaserver` для входа в Dashboard (имя не меняйте без шаблона)
DASHBOARD_USERNAME=kibanaserver
DASHBOARD_PASSWORD=kibanaserver

# Wazuh API (manager), те же значения попадут в wazuh.yml плагина
API_USERNAME=wazuh-wui
API_PASSWORD=MyS3cr37P450r.*-

# Ключ кластера manager (замените на свой, достаточно длинной случайной строки / hex)
WAZUH_CLUSTER_KEY=aa093264ef885029653eea20dfcf51ae

# Dashboard → API manager (внутренний Docker DNS)
WAZUH_API_URL=https://wazuh.manager

# Опционально только при пересборке config/wazuh_dashboard/wazuh.yml через scripts/render_secrets.py.
# Без этой строки плагин не включает строгую проверку TLS API (как в официальном compose).
# WAZUH_API_CA_PATH=/usr/share/wazuh-dashboard/certs/root-ca.pem

# Опционально только при пересборке config/wazuh_dashboard/wazuh.yml через scripts/render_secrets.py.
# WAZUH_API_RUN_AS=true

# Порт HTTPS на машине с Wazuh (в контейнере Dashboard слушает 5601). Маппинг: «хост:5601».
#
# Nginx Proxy Manager / Nginx на ЭТОЙ ЖЕ машине, что и Docker (оба хотят 443):
#   чаще DASHBOARD_HTTPS_PORT=5601 — Nginx на 443, upstream https://127.0.0.1:5601 (см. README).
# NPM на ДРУГОЙ машине в подсети: порт 443 на сервере Wazuh обычно не конфликтует — можно
#   оставить 443; в NPM укажите Forward IP = LAN-IP этой машины и этот порт.
DASHBOARD_HTTPS_PORT=443

# Режим проверки SSL для Filebeat → indexer
FILEBEAT_SSL_VERIFICATION_MODE=full

# -----------------------------------------------------------------------------
# Docker stdout/stderr логи контейнеров
# -----------------------------------------------------------------------------
# Docker Compose хранит только последние DOCKER_LOG_MAX_FILE ротированных файлов
# по DOCKER_LOG_MAX_SIZE на каждый контейнер. Это защищает диск от бесконечного
# роста логов при циклических ошибках.
DOCKER_LOG_MAX_SIZE=50m
DOCKER_LOG_MAX_FILE=7

# -----------------------------------------------------------------------------
# Опционально: готовые bcrypt для internal_users (если не хотите вызывать Docker в render_secrets.py)
# Оставьте пустыми — тогда скрипт посчитает из INDEXER_PASSWORD и DASHBOARD_PASSWORD.
# При переустановке или смене паролей не переносите старые хэши: они имеют приоритет над паролями.
# В docker compose символ $ в .env нужно удваивать: $$  (иначе $K воспринимается как переменная).
# -----------------------------------------------------------------------------
# INDEXER_ADMIN_BCRYPT_HASH=$$2y$$12$$.... 
# DASHBOARD_KIBANASERVER_BCRYPT_HASH=$$2a$$12$$....
