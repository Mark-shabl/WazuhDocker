# Та же стабильная версия, что и WazuhCentral/ (WAZUH_IMAGE_VERSION)
WAZUH_STACK_VERSION=4.14.5

# DNS-имя Wazuh manager для всех агентов (локальных и удалённых).
# Оно должно резолвиться в адрес сервера WazuhCentral, а TCP 1514/1515 должны быть доступны.
WAZUH_MANAGER_SERVER=wazuh-manager.mark-sandbox.ru

# Enrollment/authd обычно тот же host, порт 1515.
WAZUH_REGISTRATION_SERVER=wazuh-manager.mark-sandbox.ru

# Группа должна существовать в Wazuh; default есть всегда.
WAZUH_AGENT_GROUP=default

# Задайте уникальное имя, если запускаете несколько агентов.
WAZUH_AGENT_NAME=wazuh-docker-agent

# Docker stdout/stderr логи контейнера: последние 7 ротированных файлов по 50 MB.
DOCKER_LOG_MAX_SIZE=50m
DOCKER_LOG_MAX_FILE=7
