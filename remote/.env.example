# Та же стабильная версия, что и center/ (WAZUH_IMAGE_VERSION)
WAZUH_STACK_VERSION=4.14.5

# Адрес Wazuh manager.
# Если agent и center на одном Docker-хосте, docker-compose.yml подключает агента к сети
# center_default, поэтому используйте Docker DNS имя wazuh.manager.
# Если agent на другой машине, замените на LAN/VLAN IP или DNS сервера center.
WAZUH_MANAGER_SERVER=wazuh.manager

# Enrollment/authd обычно тот же host, порт 1515.
WAZUH_REGISTRATION_SERVER=wazuh.manager

# Группа должна существовать в Wazuh; default есть всегда.
WAZUH_AGENT_GROUP=default

# Задайте уникальное имя, если запускаете несколько агентов.
WAZUH_AGENT_NAME=wazuh-docker-agent
