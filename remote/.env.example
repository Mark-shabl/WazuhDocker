# Та же стабильная версия, что и center/ (WAZUH_IMAGE_VERSION)
WAZUH_STACK_VERSION=4.14.5

# Адрес Wazuh manager (порты 1514/1515 должны быть доступны с этой машины).
# На той же Windows/macOS с Docker Desktop, где крутится center/: host.docker.internal
# На Linux к другому серверу: реальный IP/DNS; при агенте на том же хосте часто 172.17.0.1 или IP LAN.
WAZUH_MANAGER_SERVER=host.docker.internal
