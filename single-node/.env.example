# Copy this file to .env and adjust values.
# docker compose reads .env automatically from this directory.

# Image tag for all Wazuh stack images (manager, indexer, dashboard)
WAZUH_STACK_VERSION=5.0.0

# Host ports published to your machine / network
WAZUH_AGENT_PORT=1514
WAZUH_REGISTRATION_PORT=1515
WAZUH_SYSLOG_UDP_PORT=514
WAZUH_API_PORT=55000
WAZUH_INDEXER_PORT=9200
WAZUH_DASHBOARD_PORT=443

# Indexer JVM heap (used as -Xms / -Xmx)
INDEXER_JAVA_HEAP=1g

# OpenSearch / indexer admin user (also used by manager and dashboard)
INDEXER_USERNAME=admin
INDEXER_PASSWORD=admin

# Built-in dashboard OpenSearch user
DASHBOARD_USERNAME=kibanaserver
DASHBOARD_PASSWORD=kibanaserver
