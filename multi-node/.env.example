# Copy this file to .env before docker compose up.

WAZUH_STACK_VERSION=5.0.0-beta1-latest

# Host ports
WAZUH_AGENT_LB_PORT=1514
WAZUH_REGISTRATION_PORT=1515
WAZUH_SYSLOG_UDP_PORT=514
WAZUH_API_PORT=55000
WAZUH_INDEXER_API_PORT=9200
WAZUH_DASHBOARD_PORT=443

# Worker identity (must stay consistent with cluster design / certs if you rename nodes)
# Manager RLIMIT_NOFILE (LXC-safe default; increase on full VMs e.g. 655360)
WAZUH_MANAGER_NOFILE_SOFT=65536
WAZUH_MANAGER_NOFILE_HARD=65536

INDEXER_JAVA_HEAP=1g

INDEXER_USERNAME=admin
INDEXER_PASSWORD=admin

DASHBOARD_USERNAME=kibanaserver
DASHBOARD_PASSWORD=kibanaserver
